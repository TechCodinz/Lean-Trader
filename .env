# ===========================================
# ULTRA TRADING SYSTEM - AUTO-SELECTED ENVIRONMENT
# The bot will automatically choose the best available credentials
# ===========================================

# ===========================================
# PRIMARY EXCHANGE - BINANCE
# ===========================================
BINANCE_API_KEY=${BINANCE_API_KEY:-}
BINANCE_SECRET=${BINANCE_SECRET:-}
BINANCE_TESTNET=false

# ===========================================
# SECONDARY EXCHANGE - BYBIT
# ===========================================
BYBIT_API_KEY=${BYBIT_API_KEY:-}
BYBIT_SECRET=${BYBIT_SECRET:-}
BYBIT_TESTNET=false

# ===========================================
# TERTIARY EXCHANGE - GATE.IO
# ===========================================
GATEIO_API_KEY=${GATEIO_API_KEY:-}
GATEIO_SECRET=${GATEIO_SECRET:-}
GATEIO_SANDBOX=false

# ===========================================
# ADDITIONAL EXCHANGES FOR ARBITRAGE
# ===========================================
COINBASE_API_KEY=${COINBASE_API_KEY:-}
COINBASE_SECRET=${COINBASE_SECRET:-}
COINBASE_PASSPHRASE=${COINBASE_PASSPHRASE:-}

KRAKEN_API_KEY=${KRAKEN_API_KEY:-}
KRAKEN_SECRET=${KRAKEN_SECRET:-}

KUCOIN_API_KEY=${KUCOIN_API_KEY:-}
KUCOIN_SECRET=${KUCOIN_SECRET:-}
KUCOIN_PASSPHRASE=${KUCOIN_PASSPHRASE:-}

# ===========================================
# ARBITRAGE CONFIGURATION
# ===========================================
ENABLE_ARBITRAGE=true
MIN_ARBITRAGE_PROFIT=0.002
MAX_ARBITRAGE_EXPOSURE=1000
ARBITRAGE_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT

# ===========================================
# SWARM CONSCIOUSNESS
# ===========================================
SWARM_ENABLED=true
SWARM_AGENTS=10
CONSENSUS_THRESHOLD=0.7
COLLECTIVE_LEARNING=true

# ===========================================
# AUTO-SELECTION PREFERENCES
# ===========================================
PREFER_LIVE_IF_AVAILABLE=false
AUTO_SELECT_BEST_EXCHANGE=true
FALLBACK_TO_PAPER=true

# ===========================================
# RISK MANAGEMENT (GLOBAL)
# ===========================================
GLOBAL_MAX_EXPOSURE=5000
MAX_POSITIONS_PER_EXCHANGE=3
GLOBAL_STOP_LOSS=0.05
GLOBAL_TAKE_PROFIT=0.10