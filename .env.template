# ============================================================================
# 🔐 TRADING BOT ENVIRONMENT CONFIGURATION
# ============================================================================
# Copy this to .env and fill in your actual values
# IMPORTANT: Never commit .env to git! It's in .gitignore

# ============================================================================
# 📡 EXCHANGE API KEYS (Primary Trading)
# ============================================================================

# Gate.io (Primary Exchange)
GATE_API_KEY=your_gate_api_key_here
GATE_SECRET=your_gate_secret_key_here
GATE_TESTNET=True  # Set to False for live trading

# Bybit (Secondary Exchange)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_key_here
BYBIT_TESTNET=True  # Set to False for live trading

# Binance (Optional - for arbitrage)
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_key_here

# OKX (Optional - for arbitrage)
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_key_here
OKX_PASSPHRASE=your_okx_passphrase_here

# Kucoin (Optional - for arbitrage)
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_SECRET=your_kucoin_secret_key_here
KUCOIN_PASSPHRASE=your_kucoin_passphrase_here

# Kraken (Optional - for arbitrage)
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET=your_kraken_secret_key_here

# ============================================================================
# 🤖 TELEGRAM BOT CONFIGURATION
# ============================================================================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here
TELEGRAM_ENABLED=True  # Set to False to disable notifications

# Premium Telegram Features
TELEGRAM_PREMIUM_ENABLED=False
TELEGRAM_SIGNAL_CHANNEL_ID=
TELEGRAM_VIP_GROUP_ID=

# ============================================================================
# 🧠 AI/ML API KEYS (For AI Consultation Features)
# ============================================================================

# OpenAI (GPT-4)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-opus-20240229

# Google (Gemini)
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_MODEL=gemini-pro

# ============================================================================
# 🔮 IBM QUANTUM (For Quantum Intelligence Features)
# ============================================================================

IBM_QUANTUM_TOKEN=your_ibm_quantum_token_here
IBM_QUANTUM_BACKEND=ibmq_qasm_simulator

# ============================================================================
# 📊 DATA & ANALYTICS
# ============================================================================

# CoinGecko (For market data)
COINGECKO_API_KEY=your_coingecko_api_key_here

# CoinMarketCap (For market cap data)
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key_here

# Glassnode (For on-chain analytics)
GLASSNODE_API_KEY=your_glassnode_api_key_here

# ============================================================================
# 💾 DATABASE CONFIGURATION
# ============================================================================

DATABASE_TYPE=sqlite  # Options: sqlite, postgresql, mongodb
DATABASE_PATH=./data/trading_bot.db

# PostgreSQL (if using)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading_bot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# MongoDB (if using)
MONGO_URI=mongodb://localhost:27017/trading_bot

# ============================================================================
# ⚙️ BOT CONFIGURATION
# ============================================================================

# Trading Mode
TRADING_MODE=testnet  # Options: testnet, paper, live
INITIAL_BALANCE=100.0

# Risk Management
MAX_POSITION_SIZE=0.02  # 2% of balance per trade
MAX_DAILY_LOSS=0.05  # 5% max daily loss
MAX_TOTAL_EXPOSURE=0.30  # 30% max total exposure

# Trading Pairs
ENABLED_PAIRS=BTC/USDT,ETH/USDT,SOL/USDT,DOGE/USDT
AUTO_DISCOVER_PAIRS=True

# Timeframes
ENABLED_TIMEFRAMES=1m,5m,15m,1h,4h,1d

# ============================================================================
# 🚀 ADVANCED FEATURES
# ============================================================================

# Consciousness System
CONSCIOUSNESS_ENABLED=True
CONSCIOUSNESS_LEVEL_TARGET=95  # 0-100

# Swarm Intelligence
SWARM_INTELLIGENCE_ENABLED=True
SWARM_SCOUT_COUNT=50

# Federated Learning
FEDERATED_LEARNING_ENABLED=True
FEDERATED_LEARNING_ROUNDS=10

# God Mode (Ultra aggressive trading)
GODMODE_ENABLED=False
GODMODE_LEVERAGE_MAX=100

# Evolution Engine
EVOLUTION_ENABLED=True
EVOLUTION_POPULATION_SIZE=20
EVOLUTION_GENERATIONS=100

# News Trading
NEWS_TRADING_ENABLED=True
NEWS_SOURCES=twitter,reddit,telegram

# Arbitrage
CROSS_EXCHANGE_ARBITRAGE_ENABLED=True
ARBITRAGE_MIN_PROFIT=0.5  # 0.5% minimum profit

# ============================================================================
# 📈 LOGGING & MONITORING
# ============================================================================

LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
LOG_FILE=./logs/bot.log
LOG_MAX_SIZE=10485760  # 10MB
LOG_BACKUP_COUNT=5

# Monitoring
ENABLE_METRICS=True
METRICS_PORT=9090

# Alerts
ALERT_ON_ERROR=True
ALERT_ON_LARGE_TRADE=True
ALERT_THRESHOLD_USD=1000

# ============================================================================
# 🔧 SYSTEM SETTINGS
# ============================================================================

# Performance
MAX_WORKERS=10
ASYNC_ENABLED=True
CACHE_ENABLED=True
CACHE_TTL=300  # 5 minutes

# Rate Limiting
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_PERIOD=60  # per minute

# Backup
AUTO_BACKUP_ENABLED=True
BACKUP_INTERVAL=3600  # 1 hour
BACKUP_LOCATION=./backups

# ============================================================================
# 🌐 WEB3 & DEX (For DeFi features)
# ============================================================================

# Ethereum
ETH_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
ETH_PRIVATE_KEY=your_eth_private_key_here

# BSC
BSC_RPC_URL=https://bsc-dataseed.binance.org/
BSC_PRIVATE_KEY=your_bsc_private_key_here

# Polygon
POLYGON_RPC_URL=https://polygon-rpc.com/
POLYGON_PRIVATE_KEY=your_polygon_private_key_here

# Solana
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_PRIVATE_KEY=your_solana_private_key_here

# ============================================================================
# 🎯 STRATEGY OVERRIDES (Optional - overrides defaults)
# ============================================================================

# Scalping Strategy
SCALPING_PROFIT_TARGET=0.005  # 0.5%
SCALPING_STOP_LOSS=0.003  # 0.3%
SCALPING_MAX_HOLD_TIME=300  # 5 minutes

# Swing Strategy
SWING_PROFIT_TARGET=0.05  # 5%
SWING_STOP_LOSS=0.03  # 3%
SWING_MAX_HOLD_TIME=86400  # 24 hours

# Arbitrage Strategy
ARB_MIN_SPREAD=0.005  # 0.5%
ARB_MAX_SLIPPAGE=0.002  # 0.2%
ARB_TIMEOUT=10  # 10 seconds

# ============================================================================
# 🔐 SECURITY
# ============================================================================

# Encryption
ENCRYPT_SENSITIVE_DATA=True
ENCRYPTION_KEY=  # Will be auto-generated if empty

# IP Whitelist (comma-separated)
IP_WHITELIST=

# 2FA for critical operations
REQUIRE_2FA=False
TOTP_SECRET=

