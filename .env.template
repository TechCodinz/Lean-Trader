# Trading Bot Environment Configuration Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env file with real credentials to version control!

# ============================================
# EXCHANGE API CONFIGURATION
# ============================================

# Bybit API (Use testnet for testing)
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_API_SECRET=your_bybit_api_secret_here
BYBIT_TESTNET=true
BYBIT_SANDBOX=true

# Binance API
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_API_SECRET=your_binance_api_secret_here
BINANCE_TESTNET=true

# Other exchanges...
OKX_API_KEY=
OKX_API_SECRET=
OKX_PASSPHRASE=

# ============================================
# TELEGRAM CONFIGURATION
# ============================================

TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHANNEL=your_admin_channel_id
TELEGRAM_FREE_CHANNEL=your_free_channel_id
TELEGRAM_VIP_CHANNEL=your_vip_channel_id

# ============================================
# RISK MANAGEMENT SETTINGS
# ============================================

# Maximum position size as percentage of portfolio
MAX_POSITION_SIZE=2.0

# Maximum daily loss limit in USD
DAILY_LOSS_LIMIT=50.0

# Maximum drawdown percentage
MAX_DRAWDOWN=10.0

# Risk per trade as percentage
RISK_PER_TRADE=2.0

# Maximum concurrent trades
MAX_CONCURRENT_TRADES=5

# Minimum confidence for auto trading (0-100)
MIN_CONFIDENCE=80

# ============================================
# TRADING SETTINGS
# ============================================

# Enable/disable trading (true/false)
TRADING_ENABLED=false

# Enable/disable auto trading
AUTO_TRADING_ENABLED=false

# Trading mode: paper, testnet, or live
TRADING_MODE=paper

# Default leverage for futures trading
DEFAULT_LEVERAGE=3

# Maximum leverage allowed
MAX_LEVERAGE=5

# ============================================
# DATABASE CONFIGURATION
# ============================================

# Database type: sqlite, postgresql, mysql
DATABASE_TYPE=sqlite

# SQLite database path
SQLITE_DB_PATH=data/trading_bot.db

# PostgreSQL/MySQL configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=trading_bot
DATABASE_USER=trading_user
DATABASE_PASSWORD=your_database_password

# ============================================
# LOGGING CONFIGURATION
# ============================================

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log directory
LOG_DIR=logs

# ============================================
# ML/AI CONFIGURATION
# ============================================

# Enable ML models
ML_ENABLED=true

# Model update frequency in hours
MODEL_UPDATE_FREQUENCY=24

# Minimum data points for training
MIN_TRAINING_DATA=1000

# ============================================
# MONITORING & ALERTS
# ============================================

# Health check interval in seconds
HEALTH_CHECK_INTERVAL=60

# Enable performance monitoring
MONITORING_ENABLED=true

# Alert thresholds
ALERT_LOSS_THRESHOLD=5.0
ALERT_DRAWDOWN_THRESHOLD=5.0

# ============================================
# API RATE LIMITS
# ============================================

# Requests per minute
RATE_LIMIT_RPM=60

# Enable rate limiting
RATE_LIMITING_ENABLED=true

# ============================================
# BACKTESTING CONFIGURATION
# ============================================

# Enable backtesting mode
BACKTESTING_ENABLED=false

# Backtesting start date (YYYY-MM-DD)
BACKTEST_START_DATE=2024-01-01

# Backtesting end date (YYYY-MM-DD)
BACKTEST_END_DATE=2024-12-31

# ============================================
# SECURITY SETTINGS
# ============================================

# Enable 2FA for critical operations
TWO_FACTOR_AUTH=false

# IP whitelist (comma-separated)
IP_WHITELIST=

# Session timeout in minutes
SESSION_TIMEOUT=30

# ============================================
# NOTIFICATION SETTINGS
# ============================================

# Email notifications
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
ALERT_EMAIL=alerts@yourdomain.com

# Discord notifications
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

# ============================================
# ADVANCED SETTINGS
# ============================================

# Strategy parameters
STRATEGY_EMA_FAST=50
STRATEGY_EMA_SLOW=200
STRATEGY_RSI_PERIOD=14
STRATEGY_BB_PERIOD=20
STRATEGY_BB_STD=2.0

# Order execution
SLIPPAGE_TOLERANCE=0.5
ORDER_TIMEOUT=30
PARTIAL_FILL_ENABLED=true

# Market data
CANDLE_TIMEFRAME=1m
ORDERBOOK_DEPTH=20
TICKER_UPDATE_INTERVAL=1

# Performance optimization
USE_WEBSOCKETS=true
CACHE_ENABLED=true
CACHE_TTL=300

# Debug mode
DEBUG_MODE=false
VERBOSE_LOGGING=false