# ===========================================
# ULTRA ARBITRAGE ENVIRONMENT TEMPLATE
# Copy this to env.arbitrage and add your keys
# ===========================================

# ===========================================
# EXCHANGE 1: BINANCE
# ===========================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_TESTNET=false

# ===========================================
# EXCHANGE 2: BYBIT
# ===========================================
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here
BYBIT_TESTNET=false

# ===========================================
# EXCHANGE 3: GATE.IO
# ===========================================
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_SECRET=your_gateio_secret_here

# ===========================================
# EXCHANGE 4: OKX
# ===========================================
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ===========================================
# EXCHANGE 5: BITGET
# ===========================================
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET=your_bitget_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# ===========================================
# EXCHANGE 6: MEXC
# ===========================================
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET=your_mexc_secret_here

# ===========================================
# EXCHANGE 7: KUCOIN (Optional)
# ===========================================
KUCOIN_API_KEY=
KUCOIN_SECRET=
KUCOIN_PASSPHRASE=

# ===========================================
# EXCHANGE 8: HUOBI (Optional)
# ===========================================
HUOBI_API_KEY=
HUOBI_SECRET=

# ===========================================
# TELEGRAM CONFIGURATION
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
TELEGRAM_FREE_CHANNEL_ID=your_free_channel_id_here
TELEGRAM_VIP_CHANNEL_ID=your_vip_channel_id_here

# ===========================================
# TRADING CONFIGURATION
# ===========================================
# Market Coverage
SCAN_ALL_PAIRS=true
TRADE_SPOT=true
TRADE_FUTURES=true
TRADE_PERPETUALS=true
TRADE_MARGIN=true

# Risk Management
RISK_PER_TRADE=0.02
MAX_POSITIONS=20
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.05
MAX_DAILY_LOSS=0.05

# Arbitrage Settings
MIN_ARBITRAGE_PROFIT_PCT=0.002
MAX_ARBITRAGE_EXPOSURE=5000
ARBITRAGE_EXECUTION_DELAY=0

# ===========================================
# FEATURES
# ===========================================
ENABLE_ARBITRAGE=true
ENABLE_AI_TRADING=true
ENABLE_SWARM=true
ENABLE_EVOLUTION=true
ENABLE_NEWS_TRADING=true
ENABLE_FUNDING_ARBITRAGE=true
ENABLE_BASIS_TRADING=true

# ===========================================
# MONITORING
# ===========================================
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=1800
SEND_PERFORMANCE_REPORTS=true
TRACK_ALL_TRADES=true