# ===========================================
# ULTRA ARBITRAGE ENVIRONMENT TEMPLATE
# Copy this to env.arbitrage and add your keys
# ===========================================

# ===========================================
# EXCHANGE 1: BINANCE
# ===========================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_TESTNET=false

# ===========================================
# EXCHANGE 2: BYBIT
# ===========================================
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here
BYBIT_TESTNET=false

# ===========================================
# EXCHANGE 3: GATE.IO
# ===========================================
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_SECRET=your_gateio_secret_here

# ===========================================
# EXCHANGE 4: OKX
# ===========================================
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here

# ===========================================
# EXCHANGE 5: BITGET
# ===========================================
BITGET_API_KEY=your_bitget_api_key_here
BITGET_SECRET=your_bitget_secret_here
BITGET_PASSPHRASE=your_bitget_passphrase_here

# ===========================================
# EXCHANGE 6: MEXC
# ===========================================
MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET=your_mexc_secret_here

# ===========================================
# EXCHANGE 7: KUCOIN (Optional)
# ===========================================
KUCOIN_API_KEY=
KUCOIN_SECRET=
KUCOIN_PASSPHRASE=

# ===========================================
# EXCHANGE 8: HUOBI (Optional)
# ===========================================
HUOBI_API_KEY=
HUOBI_SECRET=

# ===========================================
# TELEGRAM CONFIGURATION
# ===========================================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
TELEGRAM_FREE_CHANNEL_ID=your_free_channel_id_here
TELEGRAM_VIP_CHANNEL_ID=your_vip_channel_id_here

# ===========================================
# ACCOUNT CONFIGURATION
# ===========================================
INITIAL_BALANCE=48         # Your starting balance
TARGET_BALANCE=1000        # Your profit target
TIMELINE_MONTHS=3          # Target timeline

# ===========================================
# TRADING CONFIGURATION - OPTIMIZED FOR SMALL BALANCE ($48)
# ===========================================
# Market Coverage
SCAN_ALL_PAIRS=true
TRADE_SPOT=true
TRADE_FUTURES=true        # Enable for leverage opportunities
TRADE_PERPETUALS=true
TRADE_MARGIN=false         # Disable initially for safety

# Risk Management - OPTIMIZED FOR $48 START
RISK_PER_TRADE=0.10        # 10% per trade ($4.80 initially)
MAX_POSITIONS=5            # More small positions
STOP_LOSS_PCT=0.03         # 3% stop loss (wider for small balance)
TAKE_PROFIT_PCT=0.02       # 2% take profit (quick gains)
MAX_DAILY_LOSS=0.15        # 15% daily loss limit
COMPOUND_PROFITS=true      # CRITICAL: Reinvest everything
MIN_POSITION_SIZE=5        # Minimum $5 per trade
MAX_POSITION_SIZE=15       # Maximum $15 initially

# Arbitrage Settings - AGGRESSIVE FOR GROWTH
MIN_ARBITRAGE_PROFIT_PCT=0.001   # 0.1% minimum (take smaller profits)
MAX_ARBITRAGE_EXPOSURE=48        # Start with full balance
ARBITRAGE_EXECUTION_DELAY=0      # Instant execution
ARBITRAGE_FREQUENCY=high          # Maximum scanning

# ===========================================
# FEATURES
# ===========================================
ENABLE_ARBITRAGE=true
ENABLE_AI_TRADING=true
ENABLE_SWARM=true
ENABLE_EVOLUTION=true
ENABLE_NEWS_TRADING=true
ENABLE_FUNDING_ARBITRAGE=true
ENABLE_BASIS_TRADING=true

# ===========================================
# MONITORING
# ===========================================
LOG_LEVEL=INFO
HEARTBEAT_INTERVAL=1800
SEND_PERFORMANCE_REPORTS=true
TRACK_ALL_TRADES=true