# ===========================================
# ULTRA ARBITRAGE ENVIRONMENT - 7+ EXCHANGES
# For multi-exchange arbitrage opportunities
# ===========================================

# ===========================================
# MODE CONFIGURATION
# ===========================================
TRADING_MODE=arbitrage
ENABLE_ARBITRAGE=true
MULTI_EXCHANGE=true
AUTO_BALANCE_CHECK=true

# ===========================================
# EXCHANGE 1: BINANCE (PRIMARY)
# ===========================================
BINANCE_API_KEY=your_binance_api_key_here
BINANCE_SECRET=your_binance_secret_here
BINANCE_TESTNET=false
BINANCE_ENABLED=true

# ===========================================
# EXCHANGE 2: BYBIT
# ===========================================
BYBIT_API_KEY=your_bybit_api_key_here
BYBIT_SECRET=your_bybit_secret_here
BYBIT_TESTNET=false
BYBIT_ENABLED=true

# ===========================================
# EXCHANGE 3: GATE.IO
# ===========================================
GATEIO_API_KEY=your_gateio_api_key_here
GATEIO_SECRET=your_gateio_secret_here
GATEIO_SANDBOX=false
GATEIO_ENABLED=true

# ===========================================
# EXCHANGE 4: COINBASE
# ===========================================
COINBASE_API_KEY=your_coinbase_api_key_here
COINBASE_SECRET=your_coinbase_secret_here
COINBASE_PASSPHRASE=your_coinbase_passphrase_here
COINBASE_ENABLED=true

# ===========================================
# EXCHANGE 5: KRAKEN
# ===========================================
KRAKEN_API_KEY=your_kraken_api_key_here
KRAKEN_SECRET=your_kraken_secret_here
KRAKEN_ENABLED=true

# ===========================================
# EXCHANGE 6: KUCOIN
# ===========================================
KUCOIN_API_KEY=your_kucoin_api_key_here
KUCOIN_SECRET=your_kucoin_secret_here
KUCOIN_PASSPHRASE=your_kucoin_passphrase_here
KUCOIN_ENABLED=true

# ===========================================
# EXCHANGE 7: OKX
# ===========================================
OKX_API_KEY=your_okx_api_key_here
OKX_SECRET=your_okx_secret_here
OKX_PASSPHRASE=your_okx_passphrase_here
OKX_ENABLED=true

# ===========================================
# ADDITIONAL EXCHANGES (EXPANDABLE)
# ===========================================
BITFINEX_API_KEY=your_bitfinex_api_key_here
BITFINEX_SECRET=your_bitfinex_secret_here
BITFINEX_ENABLED=false

HUOBI_API_KEY=your_huobi_api_key_here
HUOBI_SECRET=your_huobi_secret_here
HUOBI_ENABLED=false

MEXC_API_KEY=your_mexc_api_key_here
MEXC_SECRET=your_mexc_secret_here
MEXC_ENABLED=false

# ===========================================
# ARBITRAGE CONFIGURATION
# ===========================================
MIN_ARBITRAGE_PROFIT_PCT=0.3  # 0.3% minimum profit
MAX_ARBITRAGE_EXPOSURE=5000   # Max $5000 per arbitrage
ARBITRAGE_SYMBOLS=BTC/USDT,ETH/USDT,BNB/USDT,SOL/USDT,MATIC/USDT,AVAX/USDT,DOT/USDT
ARBITRAGE_SCAN_INTERVAL=5     # Scan every 5 seconds
ARBITRAGE_EXECUTION_DELAY=0   # Execute immediately
PARALLEL_ARBITRAGE=true       # Execute multiple arbitrages simultaneously

# ===========================================
# BALANCE MANAGEMENT
# ===========================================
AUTO_BALANCE_TRANSFER=true    # Auto-transfer between exchanges
MIN_BALANCE_PER_EXCHANGE=100  # Minimum $100 per exchange
BALANCE_CHECK_INTERVAL=60     # Check every 60 seconds
REBALANCE_THRESHOLD=0.2       # Rebalance if 20% imbalanced

# ===========================================
# TELEGRAM NOTIFICATIONS (MULTI-CHANNEL)
# ===========================================
TELEGRAM_ENABLED=true

# Main Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Admin Channel (for bot status, errors, heartbeat)
TELEGRAM_ADMIN_CHAT_ID=your_admin_chat_id_here
TELEGRAM_ADMIN_NOTIFICATIONS=true
TELEGRAM_HEARTBEAT_ENABLED=true
TELEGRAM_HEARTBEAT_INTERVAL=1800  # 30 minutes

# Free Signals Channel
TELEGRAM_FREE_CHANNEL_ID=@your_free_channel_here
TELEGRAM_FREE_SIGNALS=true
TELEGRAM_FREE_MIN_CONFIDENCE=0.70

# VIP Signals Channel
TELEGRAM_VIP_CHANNEL_ID=@your_vip_channel_here
TELEGRAM_VIP_SIGNALS=true
TELEGRAM_VIP_MIN_CONFIDENCE=0.85

# Arbitrage Alerts Channel
TELEGRAM_ARBITRAGE_CHANNEL_ID=@your_arbitrage_channel_here
TELEGRAM_ARBITRAGE_ALERTS=true

# Performance Reports Channel
TELEGRAM_PERFORMANCE_CHANNEL_ID=@your_performance_channel_here
TELEGRAM_DAILY_REPORT=true
TELEGRAM_WEEKLY_SUMMARY=true

# ===========================================
# SIGNAL FORMATTING
# ===========================================
SIGNAL_USE_EMOJIS=true
SIGNAL_SHOW_CHART=true
SIGNAL_SHOW_ANALYSIS=true
SIGNAL_SHOW_RISK_LEVEL=true
SIGNAL_SHOW_CONFIDENCE=true
SIGNAL_INCLUDE_STOPLOSS=true
SIGNAL_INCLUDE_TARGETS=true
SIGNAL_BRANDING="🚀 Ultra Trading System 🚀"

# ===========================================
# RISK MANAGEMENT
# ===========================================
GLOBAL_MAX_EXPOSURE=50000     # Max $50k total exposure
MAX_POSITIONS_PER_EXCHANGE=5  # Max 5 positions per exchange
GLOBAL_DAILY_LOSS_LIMIT=0.05  # 5% daily loss limit
GLOBAL_STOP_LOSS=0.03          # 3% stop loss
GLOBAL_TAKE_PROFIT=0.10        # 10% take profit

# ===========================================
# SWARM CONSCIOUSNESS
# ===========================================
SWARM_ENABLED=true
SWARM_AGENTS=20
CONSENSUS_THRESHOLD=0.75
COLLECTIVE_LEARNING=true
SWARM_MEMORY_SIZE=10000

# ===========================================
# MONITORING & LOGGING
# ===========================================
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_TO_TELEGRAM=true
METRICS_ENABLED=true
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true