# Database files (Large runtime data - backup separately)
*.db-journal
*.db-wal
*.db-shm

# Keep empty db files for structure
!*_structure.db

# Environment files (sensitive)
.env.local
.env.*.local

# Backups
*_backup_*/
backup_*/

# OS
.DS_Store
Thumbs.db

# Trading data (backup separately, too large for git)
bot_data/trades.jsonl
bot_data/market_data/
bot_data/historical/

# Keep structure files
!bot_data/.gitkeep
!bot_data/README.md

# Temporary files
tmp/
temp/
*.tmp

# Large data files
*.csv
*.parquet
*.h5
*.hdf5

# Keep example/template files
!example_*.csv
!template_*.csv
