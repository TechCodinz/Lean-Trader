BYBIT_SANDBOX=true
BYBIT_TESTNET_URL=https://api-testnet.bybit.com

# ===========================================
# RISK MANAGEMENT (SAFE FOR TESTING)
# ===========================================
RISK_PER_TRADE=0.01
MAX_POSITIONS=5
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.05
MAX_DRAWDOWN_PCT=0.10
INITIAL_CAPITAL=10000  # Testnet balance

# ===========================================
# AI TRAINING CONFIGURATION
# ===========================================
ENABLE_TRAINING=true
TRAINING_INTERVAL=3600
MODEL_SAVE_INTERVAL=7200
BACKTESTING_ENABLED=true
PAPER_TRADING_PARALLEL=true
STRATEGY_EVOLUTION=true

# ===========================================
# SWARM TRAINING
# ===========================================
SWARM_ENABLED=true
SWARM_AGENTS=10
PARALLEL_TRAINING=true
TRAINING_EPOCHS=100
LEARNING_RATE=0.001

# ===========================================
# FEATURES FOR TESTING
# ===========================================
GOD_MODE_ENABLED=true
QUANTUM_PREDICTION=true
FRACTAL_ANALYSIS=true
SMART_MONEY_TRACKING=true
MOON_SPOTTER_ENABLED=true
AUTO_SNIPE_ENABLED=false

# ===========================================
# TELEGRAM NOTIFICATIONS (SAME AS PRODUCTION)
