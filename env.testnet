# Send testnet results to admin
TELEGRAM_TESTNET_NOTIFICATIONS=true
TELEGRAM_TRAINING_UPDATES=true
TELEGRAM_PERFORMANCE_REPORTS=true

# ===========================================
# DATA COLLECTION FOR TRAINING
